#!/usr/bin/env python3
"""Omarchy Voyager layout switcher — flash Oryx profiles via Zapp."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shlex
import shutil
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import urlparse

APP = "voyager-layout"
APP_VERSION = "0.2.2"
USER_AGENT = f"omarchy-voyager/{APP_VERSION} (https://github.com/fram74/omarchy-voyager)"
# Plugin / repo root (parent of bin/)
REPO_ROOT = Path(__file__).resolve().parent.parent
EXAMPLE_CONFIG = REPO_ROOT / "config" / "layouts.toml.example"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy-voyager"
CONFIG_PATH = CONFIG_DIR / "layouts.toml"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy-voyager"
STATE_CURRENT = STATE_DIR / "current"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy-voyager"
VOYAGER_VID = "3297"
# Normal mode PIDs
VOYAGER_PIDS_NORMAL = ("1977", "1978")
# Ignition bootloader PIDs (STM32 / GD32)
VOYAGER_PIDS_BOOTLOADER = ("0791", "1791")
# Ignition STM32 flash base (Zapp uses this for 3297:0791)
IGNITION_FLASH_ADDR = "0x08002000"
ORYX_API_HOST = "oryx.zsa.io"
ORYX_API_ORIGIN = f"https://{ORYX_API_HOST}"
CONFIGURE_ORIGIN = "https://configure.zsa.io"
# Compiled Voyager images are tens of KiB; this is a floor, not a substitute for sha256.
MIN_FIRMWARE_BYTES = 8192
# Hard cap so a compromised Oryx cannot fill RAM/disk before the digest is known.
MAX_FIRMWARE_BYTES = 512 * 1024
MAX_JSON_BYTES = 64 * 1024
READ_CHUNK = 64 * 1024
SHA256_HEX_LEN = 64


class OryxReadError(Exception):
    """Bounded-read failure when the caller wants to handle it (title lookup)."""


def die(msg: str, code: int = 1) -> None:
    print(f"{APP}: {msg}", file=sys.stderr)
    raise SystemExit(code)


def notify(title: str, body: str, urgent: bool = False) -> None:
    if not shutil.which("notify-send"):
        return
    cmd = ["notify-send", "-a", "Voyager", title, body]
    if urgent:
        cmd[1:1] = ["-u", "critical"]
    subprocess.run(cmd, check=False)


def token_ok(value: str) -> bool:
    return bool(value) and all(c.isalnum() or c in "-_" for c in value)


def parse_sha256(value: str) -> str:
    digest = (value or "").strip().lower()
    if len(digest) != SHA256_HEX_LEN or any(c not in "0123456789abcdef" for c in digest):
        die(f"invalid sha256 digest {value!r} (expected 64 hex characters)")
    return digest


def sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def layout_is_pinned(layout: dict) -> bool:
    sha = layout.get("sha256")
    return isinstance(sha, str) and len(sha.strip()) == SHA256_HEX_LEN


def assert_oryx_api_url(url: str) -> None:
    parsed = urlparse(url)
    if parsed.scheme != "https" or parsed.hostname != ORYX_API_HOST:
        die(f"refusing non-Oryx firmware URL: {url}")
    if parsed.path != "/graphql" and not parsed.path.startswith("/firmware/"):
        die(f"refusing unexpected Oryx path: {url}")


def oryx_open(
    url: str,
    data: bytes | None = None,
    headers: dict | None = None,
    timeout: int = 30,
    strict: bool = True,
):
    assert_oryx_api_url(url)
    hdrs = {
        "User-Agent": USER_AGENT,
        "Accept": "application/json, application/octet-stream",
    }
    if headers:
        hdrs.update(headers)
    request = urllib.request.Request(
        url,
        data=data,
        headers=hdrs,
        method="POST" if data is not None else "GET",
    )
    try:
        response = urllib.request.urlopen(request, timeout=timeout)
    except urllib.error.HTTPError as exc:
        if not strict:
            raise
        die(f"Oryx HTTP {exc.code} for {url}")
    except urllib.error.URLError as exc:
        if not strict:
            raise
        die(f"Oryx request failed: {exc.reason}")
    except TimeoutError:
        if not strict:
            raise
        die(f"Oryx request timed out: {url}")
    final = urlparse(response.geturl())
    if final.scheme != "https" or final.hostname != ORYX_API_HOST:
        response.close()
        message = f"refusing redirect away from Oryx: {response.geturl()}"
        if not strict:
            raise urllib.error.URLError(message)
        die(message)
    return response


def read_bounded(
    response,
    max_bytes: int,
    label: str,
    strict: bool = True,
) -> bytes:
    """Read an HTTP body with a hard size cap. Never call response.read() unbounded."""

    def fail(msg: str) -> None:
        if strict:
            die(msg)
        raise OryxReadError(msg)

    headers = getattr(response, "headers", None)
    claimed = None
    if headers is not None:
        raw_len = headers.get("Content-Length")
        if raw_len not in (None, ""):
            try:
                claimed = int(raw_len)
            except (TypeError, ValueError):
                fail(f"{label}: invalid Content-Length {raw_len!r}")
            if claimed is not None and claimed < 0:
                fail(f"{label}: invalid Content-Length {claimed}")
            if claimed is not None and claimed > max_bytes:
                fail(
                    f"{label} Content-Length {claimed} exceeds max {max_bytes} bytes"
                )
    chunks: list[bytes] = []
    total = 0
    while True:
        chunk = response.read(min(READ_CHUNK, max_bytes + 1))
        if not chunk:
            break
        total += len(chunk)
        if total > max_bytes:
            fail(f"{label} exceeded {max_bytes} bytes before validation")
        chunks.append(chunk)
    return b"".join(chunks)


def oryx_get_bytes(
    url: str,
    timeout: int = 60,
    max_bytes: int = MAX_FIRMWARE_BYTES,
    label: str = "Oryx download",
) -> bytes:
    with oryx_open(url, timeout=timeout) as response:
        return read_bounded(response, max_bytes, label)


def oryx_get_json(url: str, timeout: int = 30) -> dict:
    raw = oryx_get_bytes(
        url, timeout=timeout, max_bytes=MAX_JSON_BYTES, label="Oryx JSON"
    )
    try:
        data = json.loads(raw.decode())
    except (UnicodeDecodeError, json.JSONDecodeError):
        die(f"Oryx returned non-JSON from {url}")
    if not isinstance(data, dict):
        die(f"Oryx returned unexpected JSON from {url}")
    return data


def oryx_layout_url(layout_id: str, revision: str | None = None) -> str:
    tail = revision if revision else "latest"
    return f"{CONFIGURE_ORIGIN}/voyager/layouts/{layout_id}/{tail}"


def parse_oryx_geometry(url: str) -> str:
    parts = (url or "").rstrip("/").split("/")
    try:
        index = parts.index("layouts")
        geo = parts[index - 1]
    except (ValueError, IndexError):
        return "voyager"
    if geo and token_ok(geo) and geo not in ("http:", "https:", "configure.zsa.io"):
        return geo
    return "voyager"


def latest_revision_url(layout_id: str, geometry: str = "voyager") -> str:
    """Oryx stock layouts are all id 'default'; the geometry disambiguates them."""
    if not token_ok(layout_id):
        die(f"invalid layout id: {layout_id!r}")
    if not token_ok(geometry):
        die(f"invalid Oryx geometry: {geometry!r}")
    if layout_id == "default":
        return f"{ORYX_API_ORIGIN}/firmware/latest/{geometry}/default"
    return f"{ORYX_API_ORIGIN}/firmware/latest/{layout_id}"


def parse_oryx_url(url: str) -> tuple[str, str | None]:
    """Return (layout_id, revision). revision is None for omitted /latest /0."""
    raw = (url or "").strip()
    if not raw:
        die("pass an Oryx layout URL")
    if "REPLACE_ME" in raw:
        die("URL still contains REPLACE_ME — paste a real Oryx share link")
    lowered = raw.lower()
    if "configure.zsa.io" in lowered and "/voyager/" not in lowered:
        die("expected a Voyager Oryx URL (configure.zsa.io/voyager/layouts/…)")
    layout_id = parse_oryx_layout_id(raw)
    if not layout_id or layout_id in ("latest", "0") or not token_ok(layout_id):
        die(
            "could not parse layout id from URL\n"
            "  expected: https://configure.zsa.io/voyager/layouts/<id>/latest"
        )
    parts = raw.rstrip("/").split("/")
    revision = None
    try:
        index = parts.index("layouts")
        if len(parts) > index + 2:
            candidate = parts[index + 2]
            if candidate not in ("latest", "0"):
                if not token_ok(candidate):
                    die(f"invalid Oryx revision in URL: {candidate!r}")
                revision = candidate
    except ValueError:
        pass
    return layout_id, revision


def fetch_latest_revision(layout_id: str, geometry: str = "voyager") -> str:
    urls: list[str] = []
    for candidate in (
        latest_revision_url(layout_id, geometry),
        f"{ORYX_API_ORIGIN}/firmware/latest/{geometry}/{layout_id}",
    ):
        if candidate not in urls:
            urls.append(candidate)

    last_status: int | None = None
    for url in urls:
        log(f"Resolving Oryx revision: {url}")
        try:
            with oryx_open(url, timeout=30, strict=False) as resp:
                raw = read_bounded(
                    resp, MAX_JSON_BYTES, "Oryx revision lookup", strict=False
                )
            data = json.loads(raw.decode())
        except urllib.error.HTTPError as exc:
            last_status = exc.code
            if exc.code == 404:
                continue
            die(f"Oryx HTTP {exc.code} for {url}")
        except urllib.error.URLError as exc:
            die(f"Oryx request failed: {exc.reason}")
        except OryxReadError as exc:
            die(str(exc))
        except (UnicodeDecodeError, json.JSONDecodeError):
            die(f"Oryx returned non-JSON from {url}")
        if not isinstance(data, dict):
            continue
        revision = data.get("latest")
        if isinstance(revision, str) and token_ok(revision) and revision not in ("latest", "0"):
            return revision
    extra = f" (HTTP {last_status})" if last_status else ""
    die(
        f"Oryx returned no usable revision for layout {layout_id}{extra}\n"
        "  Compile the layout in Oryx first, then pin again."
    )


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def download_firmware_bytes(revision: str, dest: Path) -> tuple[bytes, Path]:
    if not token_ok(revision) or revision in ("latest", "0"):
        die(f"refusing to download unpinned revision {revision!r}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    url = f"{ORYX_API_ORIGIN}/firmware/{revision}"
    log(f"Downloading firmware {revision} …")
    data = oryx_get_bytes(
        url,
        timeout=60,
        max_bytes=MAX_FIRMWARE_BYTES,
        label="Oryx firmware",
    )
    if len(data) < MIN_FIRMWARE_BYTES:
        die(f"downloaded firmware looks too small ({len(data)} bytes)")
    partial = dest.with_name(dest.name + ".partial")
    try:
        partial.write_bytes(data)
        partial.replace(dest)
    except OSError:
        partial.unlink(missing_ok=True)
        raise
    log(f"  saved {dest} ({len(data)} bytes)")
    log(f"  sha256 {sha256_hex(data)}")
    return data, dest


def pin_layout(
    layout: dict,
    revision: str | None = None,
    expected_sha256: str | None = None,
    latest: bool = False,
) -> dict:
    """Snapshot firmware into layout['revision'] + layout['sha256']. Does not flash."""
    expected = parse_sha256(expected_sha256) if expected_sha256 else None
    file_path = layout.get("file")
    if file_path and not latest:
        path = Path(str(file_path)).expanduser()
        if not path.is_file():
            die(f"layout file missing: {path}")
        size = path.stat().st_size
        if size < MIN_FIRMWARE_BYTES:
            die(f"firmware file looks too small: {path} ({size} bytes)")
        digest = sha256_file(path)
        if expected and digest != expected:
            die(f"file digest mismatch: expected {expected}, got {digest}")
        layout["sha256"] = digest
        return layout

    url = str(layout.get("oryx") or "")
    if not url or "REPLACE_ME" in url:
        die(f"layout {layout.get('id')!r} has no usable oryx URL or file — edit {CONFIG_PATH}")
    layout_id, url_revision = parse_oryx_url(url)
    geometry = parse_oryx_geometry(url)
    if latest:
        pinned_revision = fetch_latest_revision(layout_id, geometry)
    else:
        pinned_revision = revision or url_revision or fetch_latest_revision(layout_id, geometry)
    if not token_ok(pinned_revision) or pinned_revision in ("latest", "0"):
        die(f"invalid Oryx revision: {pinned_revision!r}")
    dest = CACHE_DIR / f"{layout_id}-{pinned_revision}.bin"
    data, dest = download_firmware_bytes(pinned_revision, dest)
    digest = sha256_hex(data)
    if expected and digest != expected:
        dest.unlink(missing_ok=True)
        die(f"downloaded firmware digest mismatch: expected {expected}, got {digest}")
    layout["oryx"] = oryx_layout_url(layout_id, pinned_revision)
    layout["revision"] = pinned_revision
    layout["sha256"] = digest
    return layout


def verified_firmware_file(layout: dict) -> Path:
    """Return a local firmware file whose sha256 matches the pinned digest."""
    layout_id = layout.get("id")
    if not layout_is_pinned(layout):
        die(
            f"layout {layout_id!r} is not pinned (missing sha256).\n"
            f"  Snapshot the firmware first:  voyager-layout pin {layout_id}"
        )
    expected = parse_sha256(str(layout["sha256"]))

    file_path = layout.get("file")
    if file_path:
        path = Path(str(file_path)).expanduser()
        if not path.is_file():
            die(f"layout file missing: {path}")
        actual = sha256_file(path)
        if actual != expected:
            die(
                f"firmware digest mismatch for {layout_id!r}:\n"
                f"  expected {expected}\n"
                f"  got      {actual}\n"
                f"  If you replaced the file, re-pin:  voyager-layout pin {layout_id}"
            )
        if path.stat().st_size < MIN_FIRMWARE_BYTES:
            die(f"firmware file looks too small: {path}")
        log(f"  sha256 {actual} (verified local file)")
        return path

    url = str(layout.get("oryx") or "")
    layout_hash = parse_oryx_layout_id(url) if url else None
    revision = layout.get("revision")
    if not revision and url:
        _, revision = parse_oryx_url(url)
    if not isinstance(revision, str) or not token_ok(revision) or revision in ("latest", "0"):
        die(
            f"layout {layout_id!r} has no pinned Oryx revision.\n"
            f"  Snapshot it first:  voyager-layout pin {layout_id}"
        )
    cache_id = layout_hash or str(layout_id)
    dest = CACHE_DIR / f"{cache_id}-{revision}.bin"
    if dest.is_file():
        actual = sha256_file(dest)
        if actual == expected and dest.stat().st_size >= MIN_FIRMWARE_BYTES:
            log(f"Using cached firmware {dest}")
            log(f"  sha256 {actual} (verified)")
            return dest
        log("Cached firmware digest mismatch — re-downloading pinned revision")
        dest.unlink(missing_ok=True)

    data, dest = download_firmware_bytes(revision, dest)
    actual = sha256_hex(data)
    if actual != expected:
        dest.unlink(missing_ok=True)
        die(
            f"downloaded firmware digest mismatch for {layout_id!r}:\n"
            f"  pinned revision {revision}\n"
            f"  expected {expected}\n"
            f"  got      {actual}\n"
            "  Refusing to flash. Re-pin if you intended to take a new snapshot."
        )
    return dest


def load_config() -> dict:
    if not CONFIG_PATH.is_file():
        hint = EXAMPLE_CONFIG if EXAMPLE_CONFIG.is_file() else "config/layouts.toml.example"
        die(
            f"missing config {CONFIG_PATH}\n"
            f"  mkdir -p {CONFIG_DIR} && cp {hint} {CONFIG_PATH}"
        )
    with CONFIG_PATH.open("rb") as f:
        data = tomllib.load(f)
    layouts = data.get("layouts") or []
    if not isinstance(layouts, list):
        die("config [[layouts]] must be a list")
    for i, layout in enumerate(layouts):
        if "id" not in layout:
            die(f"layouts[{i}] missing id")
        layout_id = str(layout["id"])
        if not token_ok(layout_id) or layout_id in ("latest", "0"):
            die(f"layouts[{i}] has invalid id {layout_id!r}")
        layout["id"] = layout_id
        if layout.get("sha256"):
            layout["sha256"] = parse_sha256(str(layout["sha256"]))
        revision = layout.get("revision")
        if revision:
            revision = str(revision)
            if not token_ok(revision) or revision in ("latest", "0"):
                die(f"layouts[{i}] has invalid revision {revision!r}")
            layout["revision"] = revision
    data["layouts"] = layouts
    data.setdefault("settings", {})
    return data


def find_layout(cfg: dict, layout_id: str) -> dict:
    for layout in cfg["layouts"]:
        if layout["id"] == layout_id:
            return layout
    known = ", ".join(l["id"] for l in cfg["layouts"])
    die(f"unknown layout id {layout_id!r} (known: {known})")


def set_current(layout_id: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_CURRENT.write_text(layout_id + "\n", encoding="utf-8")


def get_current() -> str | None:
    if STATE_CURRENT.is_file():
        return STATE_CURRENT.read_text(encoding="utf-8").strip() or None
    return None


def lsusb_text() -> str:
    try:
        return subprocess.check_output(["lsusb"], text=True, stderr=subprocess.DEVNULL)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return ""


def voyager_mode() -> str:
    """Return 'normal', 'bootloader', or 'missing'."""
    out = lsusb_text().lower()
    vid = VOYAGER_VID.lower()
    for pid in VOYAGER_PIDS_BOOTLOADER:
        if f"{vid}:{pid}" in out:
            return "bootloader"
    for pid in VOYAGER_PIDS_NORMAL:
        if f"{vid}:{pid}" in out:
            return "normal"
    if f"id {vid}:" in out or f"{vid}:" in out:
        return "normal"
    return "missing"


def voyager_connected() -> bool:
    return voyager_mode() != "missing"


def print_flash_howto() -> None:
    print(
        """
Flash procedure (important — avoids the USB protocol error):
  1. Voyager must be in NORMAL mode first (keys work). If unsure: unplug USB, wait 5s, replug.
  2. Use a direct laptop port (no hub/dock), short cable, both halves joined.
  3. Start the flash command and WAIT until you see:
       Waiting for keyboard in bootloader mode...
  4. Only THEN press the Reset button ONCE (top edge near the 3 key).
  5. Do not press Reset during download / before the waiting line.

If zapp keeps failing:  voyager-layout flash gaming --method dfu-util
""".strip()
    )


def ensure_normal_mode() -> None:
    mode = voyager_mode()
    if mode == "missing":
        die("Voyager not detected on USB — plug it in and try again")
    if mode == "bootloader":
        die(
            "Voyager is already in BOOTLOADER mode.\n"
            "  Unplug the USB cable, wait 5 seconds, plug back in (keys should work),\n"
            "  then run the flash command again and press Reset only AFTER the waiting line."
        )


def cmd_list(cfg: dict, as_json: bool) -> None:
    current = get_current()
    rows = []
    for layout in cfg["layouts"]:
        rows.append(
            {
                "id": layout["id"],
                "name": layout.get("name", layout["id"]),
                "oryx": layout.get("oryx"),
                "file": layout.get("file"),
                "revision": layout.get("revision"),
                "sha256": layout.get("sha256"),
                "pinned": layout_is_pinned(layout),
                "current": layout["id"] == current,
            }
        )
    # Selected / current layout always first; others keep config order.
    rows.sort(key=lambda row: (0 if row["current"] else 1))
    if as_json:
        print(json.dumps(rows, indent=2))
        return
    for row in rows:
        mark = " *" if row["current"] else ""
        pin = "" if row["pinned"] else " (unpinned)"
        print(f"{row['id']:16}  {row['name']}{mark}{pin}")


def cmd_status(cfg: dict, as_json: bool) -> None:
    current = get_current()
    mode = voyager_mode()
    zapp = shutil.which("zapp")
    dfu = shutil.which("dfu-util")
    default = (cfg.get("settings") or {}).get("default")
    current_name = None
    if current:
        for layout in cfg.get("layouts") or []:
            if layout.get("id") == current:
                current_name = layout.get("name") or current
                break
        if current_name is None:
            current_name = current
    info = {
        "connected": mode != "missing",
        "mode": mode,
        "current": current,
        "current_name": current_name,
        "default": default,
        "zapp": zapp,
        "zapp_installed": bool(zapp),
        "dfu_util": dfu,
        "dfu_installed": bool(dfu),
        "ready_to_flash": bool(zapp),
        "config": str(CONFIG_PATH),
        "repo": str(REPO_ROOT),
        "usb_vid": VOYAGER_VID,
        "unpinned": [
            layout["id"]
            for layout in cfg.get("layouts") or []
            if not layout_is_pinned(layout)
        ],
    }
    if as_json:
        print(json.dumps(info, indent=2))
        return
    print(f"config:    {CONFIG_PATH}")
    print(f"connected: {'yes' if mode != 'missing' else 'no'} (mode: {mode})")
    if current_name and current_name != current:
        print(f"current:   {current_name} ({current})")
    else:
        print(f"current:   {current or '(none recorded)'}")
    print(f"default:   {default or '(unset)'}")
    print(f"zapp:      {zapp or 'NOT FOUND — run: voyager-layout install-deps'}")
    print(f"dfu-util:  {dfu or 'optional — included by install-deps --with-dfu'}")
    if info["unpinned"]:
        print(f"unpinned:  {', '.join(info['unpinned'])} — run: voyager-layout pin --all")


def ensure_zapp() -> str:
    zapp = shutil.which("zapp")
    if not zapp:
        die(
            "zapp not found.\n"
            "  Install flash tools with:  voyager-layout install-deps\n"
            "  Or:  omarchy pkg aur add zsa-zapp   /   yay -S zsa-zapp"
        )
    return zapp


def cmd_install_deps(with_dfu: bool, yes: bool) -> None:
    """Install Zapp (AUR) and optionally dfu-util. User-initiated — not an Omarchy hook."""
    missing = []
    if not shutil.which("zapp"):
        missing.append("zsa-zapp (AUR)")
    if with_dfu and not shutil.which("dfu-util"):
        missing.append("dfu-util")

    if not missing:
        print("All flash tools already installed.")
        print(f"  zapp:     {shutil.which('zapp')}")
        if with_dfu:
            print(f"  dfu-util: {shutil.which('dfu-util')}")
        return

    print("Will install:", ", ".join(missing))
    print(
        "Note: Omarchy plugins cannot auto-install packages on "
        "`omarchy plugin add`. This command is run by you (or the bar button)."
    )

    if not yes and sys.stdin.isatty():
        ans = input("Continue? [y/N] ").strip().lower()
        if ans not in ("y", "yes"):
            raise SystemExit(1)

    code = 0
    if not shutil.which("zapp"):
        if shutil.which("omarchy"):
            print("→ omarchy pkg aur add zsa-zapp")
            code = subprocess.call(["omarchy", "pkg", "aur", "add", "zsa-zapp"])
        elif shutil.which("yay"):
            print("→ yay -S --needed zsa-zapp")
            code = subprocess.call(["yay", "-S", "--needed", "zsa-zapp"])
        else:
            die("need `omarchy` or `yay` to install zsa-zapp from the AUR")
        if code != 0:
            raise SystemExit(code)

    if with_dfu and not shutil.which("dfu-util"):
        if shutil.which("omarchy"):
            print("→ omarchy pkg add dfu-util")
            code = subprocess.call(["omarchy", "pkg", "add", "dfu-util"])
        else:
            print("→ sudo pacman -S --needed dfu-util")
            code = subprocess.call(["sudo", "pacman", "-S", "--needed", "dfu-util"])
        if code != 0:
            raise SystemExit(code)

    print("ok — flash tools ready")
    if shutil.which("zapp"):
        print(f"  zapp:     {shutil.which('zapp')}")
    if shutil.which("dfu-util"):
        print(f"  dfu-util: {shutil.which('dfu-util')}")


def parse_oryx_layout_id(url: str) -> str | None:
    # https://configure.zsa.io/voyager/layouts/<id>/...
    parts = url.rstrip("/").split("/")
    try:
        i = parts.index("layouts")
        return parts[i + 1]
    except (ValueError, IndexError):
        return None


def _toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def format_layout_block(layout: dict) -> str:
    lid = _toml_escape(str(layout["id"]))
    name = _toml_escape(str(layout.get("name", layout["id"])))
    lines = [
        "[[layouts]]\n",
        f'id = "{lid}"\n',
        f'name = "{name}"\n',
    ]
    if layout.get("oryx"):
        lines.append(f'oryx = "{_toml_escape(str(layout["oryx"]))}"\n')
    if layout.get("revision"):
        lines.append(f'revision = "{_toml_escape(str(layout["revision"]))}"\n')
    if layout.get("sha256"):
        lines.append(f'sha256 = "{_toml_escape(str(layout["sha256"]))}"\n')
    if layout.get("file"):
        lines.append(f'file = "{_toml_escape(str(layout["file"]))}"\n')
    return "".join(lines)


def write_new_config(layout: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    body = (
        "# Managed by voyager-layout (add from the bar or CLI).\n"
        "# Flash only uses a pinned revision + sha256; re-pin to take a new snapshot.\n\n"
        "[settings]\n"
        f'default = "{_toml_escape(str(layout["id"]))}"\n'
        "notify = true\n\n"
        f"{format_layout_block(layout)}"
    )
    CONFIG_PATH.write_text(body, encoding="utf-8")


def write_config(cfg: dict) -> None:
    """Rewrite layouts.toml from a loaded config dict (comments are not preserved)."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    settings = cfg.get("settings") or {}
    lines = [
        "# Managed by voyager-layout (add from the bar or CLI).\n",
        "# Flash requires a pinned revision + sha256; run: voyager-layout pin <id>\n",
        "\n",
        "[settings]\n",
    ]
    default = settings.get("default")
    if default:
        lines.append(f'default = "{_toml_escape(str(default))}"\n')
    notify = settings.get("notify", True)
    lines.append(f"notify = {'true' if notify else 'false'}\n")
    lines.append("\n")
    for layout in cfg.get("layouts") or []:
        lines.append(format_layout_block(layout))
        lines.append("\n")
    CONFIG_PATH.write_text("".join(lines), encoding="utf-8")


def append_layout(layout: dict) -> None:
    text = CONFIG_PATH.read_text(encoding="utf-8") if CONFIG_PATH.is_file() else ""
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    text += format_layout_block(layout)
    if not text.endswith("\n"):
        text += "\n"
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(text, encoding="utf-8")


def fetch_oryx_layout_title(layout_id: str, geometry: str = "voyager") -> str | None:
    """Return the human title from Oryx GraphQL, or None on failure."""
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "Origin": CONFIGURE_ORIGIN,
        "Referer": f"{CONFIGURE_ORIGIN}/{geometry}/layouts/{layout_id}/latest",
    }
    queries = [
        {
            "query": (
                "query($hashId: String!, $geometry: String!) {"
                "  layout(hashId: $hashId, geometry: $geometry, revisionId: \"latest\") {"
                "    title"
                "  }"
                "}"
            ),
            "variables": {"hashId": layout_id, "geometry": geometry},
        },
        {
            "query": (
                "{ layout(hashId: \"%s\", geometry: \"%s\", revisionId: \"latest\")"
                " { title } }" % (layout_id.replace('"', ""), geometry.replace('"', ""))
            )
        },
    ]
    for body in queries:
        try:
            payload = json.dumps(body).encode("utf-8")
            with oryx_open(
                f"{ORYX_API_ORIGIN}/graphql",
                data=payload,
                headers=headers,
                timeout=20,
                strict=False,
            ) as resp:
                raw = read_bounded(
                    resp, MAX_JSON_BYTES, "Oryx GraphQL", strict=False
                )
                data = json.loads(raw.decode())
        except (
            urllib.error.URLError,
            TimeoutError,
            json.JSONDecodeError,
            OSError,
            ValueError,
            OryxReadError,
        ):
            continue
        layout = (data.get("data") or {}).get("layout") or {}
        title = layout.get("title")
        if isinstance(title, str):
            title = title.strip()
            if title:
                return title
    return None


def load_config_optional() -> dict:
    """Load config or return empty structure if the file is missing."""
    if not CONFIG_PATH.is_file():
        return {"layouts": [], "settings": {}}
    return load_config()


def read_clipboard_text() -> str:
    for cmd in (
        ["wl-paste", "--no-newline"],
        ["wl-paste"],
        ["xclip", "-selection", "clipboard", "-o"],
        ["xsel", "--clipboard", "--output"],
    ):
        if not shutil.which(cmd[0]):
            continue
        try:
            out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
        except (FileNotFoundError, subprocess.CalledProcessError):
            continue
        text = (out or "").strip()
        if text:
            return text
    return ""


def prompt_oryx_url() -> str:
    """Ask for an Oryx URL on a TTY (Ctrl+Shift+V paste in the terminal)."""
    print("Paste a compiled Oryx share URL, then Enter.")
    print("(In the terminal, paste with Ctrl+Shift+V.)")
    print("Example: https://configure.zsa.io/voyager/layouts/<id>/latest")
    try:
        return input("Oryx URL: ").strip()
    except EOFError:
        return ""


def cmd_add(url: str, as_json: bool, expected_sha256: str | None = None) -> None:
    def fail(msg: str) -> None:
        if as_json:
            print(json.dumps({"error": msg}))
        else:
            print(f"{APP}: {msg}", file=sys.stderr)
        raise SystemExit(1)

    raw = (url or "").strip()
    if not raw:
        fail("pass an Oryx layout URL")
    if "REPLACE_ME" in raw:
        fail("URL still contains REPLACE_ME — paste a real Oryx share link")
    lowered = raw.lower()
    if "configure.zsa.io" in lowered and "/voyager/" not in lowered:
        fail("expected a Voyager Oryx URL (configure.zsa.io/voyager/layouts/…)")
    layout_id = parse_oryx_layout_id(raw)
    if not layout_id or layout_id in ("latest", "0") or not token_ok(layout_id):
        fail(
            "could not parse layout id from URL "
            "(expected …/voyager/layouts/<id>/latest)"
        )
    parts = raw.rstrip("/").split("/")
    url_revision = None
    try:
        index = parts.index("layouts")
        if len(parts) > index + 2 and parts[index + 2] not in ("latest", "0"):
            if not token_ok(parts[index + 2]):
                fail(f"invalid Oryx revision in URL: {parts[index + 2]!r}")
            url_revision = parts[index + 2]
    except ValueError:
        pass

    oryx_title = fetch_oryx_layout_title(layout_id)
    name = oryx_title or layout_id
    layout = {
        "id": layout_id,
        "name": name,
        "oryx": oryx_layout_url(layout_id, url_revision),
    }
    try:
        pin_layout(layout, revision=url_revision, expected_sha256=expected_sha256)
    except SystemExit:
        if as_json:
            print(json.dumps({"error": f"failed to pin firmware for {layout_id}"}))
        raise

    created = False
    if not CONFIG_PATH.is_file():
        write_new_config(layout)
        created = True
    else:
        cfg = load_config_optional()
        existing = next((row for row in cfg["layouts"] if row.get("id") == layout_id), None)
        if existing is not None:
            existing.update(layout)
            write_config(cfg)
        else:
            append_layout(layout)
            created = True

    info = {
        "id": layout_id,
        "name": name,
        "oryx": layout.get("oryx"),
        "revision": layout.get("revision"),
        "sha256": layout.get("sha256"),
        "pinned": True,
        "created": created,
        "config": str(CONFIG_PATH),
        "name_from_oryx": bool(oryx_title),
    }
    if as_json:
        print(json.dumps(info, indent=2))
        return
    action = "added" if created else "updated"
    print(f"ok — {action} layout {name!r} ({layout_id})")
    if not oryx_title:
        print("  note:    Oryx title unavailable (private layout or network) — using id")
    print(f"  oryx:     {layout.get('oryx')}")
    print(f"  revision: {layout.get('revision')}")
    print(f"  sha256:   {layout.get('sha256')}")
    print(f"  config:   {CONFIG_PATH}")


def cmd_remove(layout_id: str, as_json: bool) -> None:
    def fail(msg: str) -> None:
        if as_json:
            print(json.dumps({"error": msg}))
        else:
            print(f"{APP}: {msg}", file=sys.stderr)
        raise SystemExit(1)

    layout_id = (layout_id or "").strip()
    if not layout_id:
        fail("pass a layout id to remove")
    if not CONFIG_PATH.is_file():
        fail(f"missing config {CONFIG_PATH}")

    cfg = load_config()
    current = get_current()
    if current and layout_id == current:
        fail(f"cannot remove {layout_id!r} — it is the layout in use")

    before = len(cfg["layouts"])
    cfg["layouts"] = [l for l in cfg["layouts"] if l.get("id") != layout_id]
    if len(cfg["layouts"]) == before:
        fail(f"unknown layout id {layout_id!r}")

    settings = cfg.setdefault("settings", {})
    if settings.get("default") == layout_id:
        settings["default"] = cfg["layouts"][0]["id"] if cfg["layouts"] else ""
        if not settings["default"]:
            settings.pop("default", None)

    if not cfg["layouts"]:
        # Keep a valid empty-ish file rather than deleting config entirely.
        write_config(cfg)
    else:
        write_config(cfg)

    if get_current() == layout_id:
        if STATE_CURRENT.is_file():
            STATE_CURRENT.unlink()

    info = {
        "removed": layout_id,
        "remaining": [l["id"] for l in cfg["layouts"]],
        "config": str(CONFIG_PATH),
    }
    if as_json:
        print(json.dumps(info, indent=2))
        return
    print(f"ok — removed layout {layout_id!r}")
    print(f"  config: {CONFIG_PATH}")


def cmd_sync_names(as_json: bool) -> None:
    """Refresh layout names from Oryx titles (uses hash from oryx URL when present)."""
    cfg = load_config()
    updated = []
    for layout in cfg["layouts"]:
        lid = layout["id"]
        hash_id = parse_oryx_layout_id(str(layout.get("oryx") or "")) or lid
        title = fetch_oryx_layout_title(hash_id)
        if title and title != layout.get("name"):
            layout["name"] = title
            updated.append({"id": lid, "name": title, "hash": hash_id})
        elif not layout.get("name"):
            layout["name"] = lid
    write_config(cfg)
    info = {"updated": updated, "config": str(CONFIG_PATH)}
    if as_json:
        print(json.dumps(info, indent=2))
        return
    if not updated:
        print("ok — names already up to date")
    else:
        print(f"ok — updated {len(updated)} name(s)")
        for row in updated:
            print(f"  {row['id']} → {row['name']}")


def cmd_pin(
    cfg: dict,
    layout_id: str | None,
    revision: str | None,
    all_layouts: bool,
    as_json: bool,
    expected_sha256: str | None = None,
) -> None:
    """Download firmware (or hash a local file) and store revision + sha256. Does not flash."""
    if layout_id and all_layouts:
        die("pass a layout id or --all, not both")
    if revision and all_layouts:
        die("--revision cannot be combined with --all")
    if revision and (not token_ok(revision) or revision in ("latest", "0")):
        die(f"invalid Oryx revision: {revision!r}")

    # No id and no --all: pin everything (what people type after reading "run pin").
    if all_layouts or not layout_id:
        targets = list(cfg["layouts"])
        if not targets:
            die("no layouts in config to pin")
    else:
        targets = [find_layout(cfg, layout_id)]

    pinned = []
    failed = []
    for layout in targets:
        try:
            pin_layout(
                layout,
                revision=revision,
                expected_sha256=expected_sha256,
                latest=revision is None and not layout.get("file"),
            )
            pinned.append(
                {
                    "id": layout["id"],
                    "name": layout.get("name", layout["id"]),
                    "oryx": layout.get("oryx"),
                    "revision": layout.get("revision"),
                    "sha256": layout.get("sha256"),
                    "file": layout.get("file"),
                }
            )
        except SystemExit as exc:
            if not isinstance(exc.code, int) or exc.code == 0:
                raise
            failed.append(str(layout.get("id")))
    if pinned:
        write_config(cfg)
    info = {
        "pinned": pinned,
        "failed": failed,
        "config": str(CONFIG_PATH),
    }
    if as_json:
        print(json.dumps(info, indent=2))
        if failed:
            raise SystemExit(1)
        return
    if pinned:
        print(f"ok — pinned {len(pinned)} layout(s)")
        for row in pinned:
            rev = row.get("revision") or "(local file)"
            print(f"  {row['id']}: revision={rev} sha256={row['sha256']}")
    if failed:
        die(
            "failed to pin: "
            + ", ".join(failed)
            + (" (other layouts were saved)" if pinned else "")
        )


def wait_for_bootloader(timeout_sec: int = 60) -> str:
    """Block until Voyager appears in bootloader; return PID."""
    import time

    print("Waiting for keyboard in bootloader mode...")
    print(">>> Press the Voyager Reset button ONCE now.")
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        out = lsusb_text().lower()
        for pid in VOYAGER_PIDS_BOOTLOADER:
            if f"{VOYAGER_VID.lower()}:{pid}" in out:
                # Settle — zapp skips this when bootloader is already present;
                # that race causes "hardware fault or protocol violation".
                print(f"  bootloader detected (3297:{pid}) — settling 2s …")
                time.sleep(2.0)
                return pid
        time.sleep(0.25)
    die("timed out waiting for bootloader — press Reset only after this wait starts")


def flash_with_dfu_util(bin_path: Path) -> int:
    dfu = shutil.which("dfu-util")
    if not dfu:
        die("dfu-util not found. Install with: voyager-layout install-deps --with-dfu")

    pid = wait_for_bootloader()
    # Prefer matching the live bootloader PID; STM32 Ignition is 0791.
    spec = f"{VOYAGER_VID}:{pid}"
    cmd = [
        dfu,
        "-d",
        spec,
        "-a",
        "0",
        "-s",
        f"{IGNITION_FLASH_ADDR}:leave",
        "-D",
        str(bin_path),
    ]
    print("Running:", " ".join(cmd))
    return subprocess.call(cmd)


def flash_with_zapp(bin_path: Path) -> int:
    zapp = ensure_zapp()
    return subprocess.call([zapp, "flash", str(bin_path)])


def cmd_open(cfg: dict, layout_id: str | None) -> None:
    if not layout_id:
        layout_id = get_current() or (cfg.get("settings") or {}).get("default")
    if not layout_id:
        die("pass a layout id, or set settings.default / flash once first")
    layout = find_layout(cfg, layout_id)
    url = layout.get("oryx")
    if not url or "REPLACE_ME" in str(url):
        die(f"layout {layout_id!r} has no oryx URL to open")
    # Prefer Omarchy browser launcher when present.
    if shutil.which("omarchy-launch-browser"):
        subprocess.Popen(["omarchy-launch-browser", url])
    elif shutil.which("xdg-open"):
        subprocess.Popen(["xdg-open", url])
    else:
        print(url)
        return
    print(f"opened {url}")


def cmd_flash(cfg: dict, layout_id: str | None, latest: bool, method: str) -> None:
    settings = cfg.get("settings") or {}
    do_notify = bool(settings.get("notify", True))

    ensure_normal_mode()
    print_flash_howto()

    if not layout_id:
        layout_id = get_current() if latest else settings.get("default")
        if latest and not layout_id:
            layout_id = settings.get("default")
    if not layout_id:
        die("pass a layout id or --latest, or set settings.default")

    layout = find_layout(cfg, layout_id)
    name = layout.get("name", layout_id)

    if latest:
        if layout.get("file") and not layout.get("oryx"):
            die(
                f"layout {layout_id!r} is a local file — there is no Oryx latest to re-pin.\n"
                f"  Re-hash the file with:  voyager-layout pin {layout_id}"
            )
        log(f"Re-pinning {layout_id!r} to the current Oryx latest revision …")
        pin_layout(layout, revision=None, latest=True)
        write_config(cfg)

    if do_notify:
        notify(
            "Voyager",
            f"Flashing “{name}” — wait for prompt, then press Reset once",
            urgent=True,
        )

    bin_path = verified_firmware_file(layout)
    digest = layout.get("sha256")
    revision = layout.get("revision") or "local-file"
    print(f"Flashing layout {layout_id!r} via {method}")
    print(f"  firmware: {bin_path}")
    print(f"  revision: {revision}")
    print(f"  sha256:   {digest}")
    print(">>> Wait for: Waiting for keyboard in bootloader mode...")
    print(">>> Then press Reset ONCE.")
    if method == "zapp":
        code = flash_with_zapp(bin_path)
    elif method == "dfu-util":
        code = flash_with_dfu_util(bin_path)
    else:
        die(f"unknown method {method!r}")

    if code == 0:
        set_current(layout_id)
        if do_notify:
            notify("Voyager", f"Flashed “{name}”")
        print(f"ok — recorded current={layout_id}")
    else:
        if do_notify:
            notify("Voyager", f"Flash failed for “{name}”", urgent=True)
        print(
            "\nFlash failed. Common fix for 'hardware fault or protocol violation':\n"
            "  • Unplug Voyager, wait 5s, replug (must be in normal typing mode)\n"
            "  • Direct USB port, no hub\n"
            "  • Press Reset ONLY after the waiting line appears\n"
            "  • Retry with:  voyager-layout flash "
            f"{layout_id} --method dfu-util\n",
            file=sys.stderr,
        )
        raise SystemExit(code)


def cmd_pick(cfg: dict, method: str = "zapp") -> None:
    """Interactive pick via Omarchy menu (or fuzzel/rofi fallback), then flash."""
    # Options for omarchy-menu-select: optional "glyph<TAB>label" or
    # "glyph<TAB>label<TAB>subtext". Subtext is returned as stable key.
    current = get_current()
    options: list[str] = []
    for layout in cfg["layouts"]:
        name = layout.get("name", layout["id"])
        lid = layout["id"]
        # Checkmark for the layout in use; keyboard for the rest.
        glyph = "󰄬" if lid == current else "󰌌"
        options.append(f"{glyph}\t{name}\t{lid}")

    choice = None

    # Prefer Omarchy's native select menu (always present on Omarchy).
    if shutil.which("omarchy-menu-select") or shutil.which("omarchy"):
        cmd = ["omarchy", "menu", "select", "Voyager layout", *options]
        proc = subprocess.run(cmd, text=True, capture_output=True)
        if proc.returncode != 0:
            # User cancelled or menu failed
            if proc.stderr.strip():
                print(proc.stderr.strip(), file=sys.stderr)
            raise SystemExit(proc.returncode or 1)
        # Returns "label" or "label<TAB>subtext" — we want the id (subtext).
        raw = proc.stdout.strip()
        if not raw:
            raise SystemExit(1)
        parts = raw.split("\t")
        choice = parts[-1].strip() if parts else ""
    else:
        labels = [f"{l['id']}\t{l.get('name', l['id'])}" for l in cfg["layouts"]]
        text = "\n".join(labels) + "\n"
        picker = next((c for c in ("fuzzel", "walker", "rofi", "wofi") if shutil.which(c)), None)
        if not picker:
            die("no picker found — install Omarchy menu or use: voyager-layout flash <id>")
        if picker == "fuzzel":
            args = ["fuzzel", "--dmenu", "--prompt=Voyager layout> "]
        elif picker == "walker":
            args = ["walker", "-d", "-p", "Voyager layout"]
        elif picker == "rofi":
            args = ["rofi", "-dmenu", "-p", "Voyager layout"]
        else:
            args = ["wofi", "--dmenu", "-p", "Voyager layout"]
        proc = subprocess.run(args, input=text, text=True, capture_output=True)
        if proc.returncode != 0 or not proc.stdout.strip():
            raise SystemExit(1)
        choice = proc.stdout.strip().split("\t", 1)[0].strip()

    if not choice:
        raise SystemExit(1)
    # If user somehow picked a display name, map it back to an id.
    ids = {l["id"] for l in cfg["layouts"]}
    if choice not in ids:
        for layout in cfg["layouts"]:
            if layout.get("name") == choice:
                choice = layout["id"]
                break
    if choice not in ids or not token_ok(choice):
        die(f"picker returned unknown layout {choice!r}")
    if method not in ("zapp", "dfu-util"):
        die(f"unknown method {method!r}")

    # From the bar/menu there is no TTY — open a floating terminal so the
    # "Waiting for bootloader / press Reset" prompt is visible.
    if not sys.stdin.isatty() and shutil.which(
        "omarchy-launch-floating-terminal-with-presentation"
    ):
        flash_cmd = (
            f"voyager-layout flash {shlex.quote(choice)} "
            f"--method {shlex.quote(method)}; echo; read -k 1"
        )
        subprocess.Popen(
            ["omarchy-launch-floating-terminal-with-presentation", flash_cmd]
        )
        return

    cmd_flash(cfg, choice, latest=False, method=method)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=APP,
        description="Switch ZSA Voyager Oryx layouts from Omarchy (flash via Zapp).",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    list_p = sub.add_parser("list", help="List configured layouts")
    list_p.add_argument("--json", action="store_true")

    st = sub.add_parser("status", help="Connection, current layout, zapp")
    st.add_argument("--json", action="store_true")

    flash = sub.add_parser("flash", help="Flash a layout (then press Reset)")
    flash.add_argument("id", nargs="?", help="Layout id from config")
    flash.add_argument(
        "--latest",
        action="store_true",
        help="Re-pin this layout (or the current one) to Oryx latest, then flash the verified file",
    )
    flash.add_argument(
        "--method",
        choices=("zapp", "dfu-util"),
        default="zapp",
        help="Flash backend (dfu-util adds a settle delay; use if zapp hits USB faults)",
    )

    open_p = sub.add_parser("open", help="Open layout in Oryx (browser)")
    open_p.add_argument("id", nargs="?", help="Layout id (default: current/default)")

    sub.add_parser("pick", help="Picker UI then flash")

    deps = sub.add_parser(
        "install-deps",
        help="Install Zapp (AUR) so layouts can be flashed (user-initiated)",
    )
    deps.add_argument(
        "--with-dfu",
        action="store_true",
        help="Also install dfu-util (optional fallback flasher)",
    )
    deps.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Do not prompt for confirmation",
    )

    add_p = sub.add_parser(
        "add",
        help="Add a layout from an Oryx URL and pin its firmware digest",
    )
    add_p.add_argument(
        "url",
        nargs="?",
        help="Oryx URL, e.g. https://configure.zsa.io/voyager/layouts/<id>/latest",
    )
    add_p.add_argument(
        "--clipboard",
        "-c",
        action="store_true",
        help="Read the Oryx URL from the clipboard (wl-paste)",
    )
    add_p.add_argument(
        "--sha256",
        dest="sha256",
        help="Require this SHA-256 of the downloaded firmware (64 hex chars)",
    )
    add_p.add_argument("--json", action="store_true")

    pin_p = sub.add_parser(
        "pin",
        help="Snapshot firmware (revision + sha256) without flashing",
    )
    pin_p.add_argument(
        "id",
        nargs="?",
        help="Layout id from config (omit, or pass --all, to pin every layout)",
    )
    pin_p.add_argument(
        "--all",
        action="store_true",
        help="Pin every layout in the config (default if no id is given)",
    )
    pin_p.add_argument(
        "--revision",
        help="Pin this Oryx revision instead of resolving latest",
    )
    pin_p.add_argument(
        "--sha256",
        dest="sha256",
        help="Require this SHA-256 of the firmware (64 hex chars)",
    )
    pin_p.add_argument("--json", action="store_true")

    rm_p = sub.add_parser("remove", help="Remove a layout from the config")
    rm_p.add_argument("id", help="Layout id to remove")
    rm_p.add_argument("--json", action="store_true")

    sync_p = sub.add_parser(
        "sync-names",
        help="Refresh layout display names from Oryx titles",
    )
    sync_p.add_argument("--json", action="store_true")
    return p


def main(argv: list[str] | None = None) -> None:
    args = build_parser().parse_args(argv)

    # status / install-deps / add work even before layouts.toml exists
    if args.cmd == "status":
        cfg: dict = {"layouts": [], "settings": {}}
        if CONFIG_PATH.is_file():
            cfg = load_config()
        cmd_status(cfg, args.json)
        return

    if args.cmd == "install-deps":
        cmd_install_deps(with_dfu=args.with_dfu, yes=args.yes)
        return

    if args.cmd == "add":
        url = args.url
        if args.clipboard:
            url = read_clipboard_text()
            if not url:
                if args.json:
                    print(json.dumps({"error": "clipboard is empty — copy an Oryx URL first"}))
                    raise SystemExit(1)
                die("clipboard is empty — copy an Oryx URL first")
        if not url:
            if args.json:
                print(json.dumps({"error": "pass an Oryx URL, or use --clipboard"}))
                raise SystemExit(1)
            if not sys.stdin.isatty():
                die("pass an Oryx URL, or run in a terminal to paste one")
            url = prompt_oryx_url()
            if not url:
                die("no URL entered")
        cmd_add(url, args.json, expected_sha256=args.sha256)
        return

    if args.cmd == "remove":
        cmd_remove(args.id, args.json)
        return

    if args.cmd == "sync-names":
        cmd_sync_names(args.json)
        return

    if args.cmd == "pin":
        cmd_pin(
            load_config(),
            args.id,
            revision=args.revision,
            all_layouts=args.all,
            as_json=args.json,
            expected_sha256=args.sha256,
        )
        return

    if args.cmd == "list":
        if not CONFIG_PATH.is_file():
            if args.json:
                print("[]")
                return
            die(
                f"missing config {CONFIG_PATH}\n"
                f"  Add a layout from the bar, or:\n"
                f"  mkdir -p {CONFIG_DIR} && cp {EXAMPLE_CONFIG} {CONFIG_PATH}"
            )
        cmd_list(load_config(), args.json)
        return

    cfg = load_config()
    if args.cmd == "flash":
        cmd_flash(cfg, args.id, args.latest, args.method)
    elif args.cmd == "open":
        cmd_open(cfg, args.id)
    elif args.cmd == "pick":
        cmd_pick(cfg)
    else:
        die(f"unknown command {args.cmd}")


if __name__ == "__main__":
    main()
